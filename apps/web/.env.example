# apps/web environment variables.
# Local: copy to .env.local and fill in real values. Hosted: set them in the Vercel project
# (Settings -> Environment Variables), separately for Preview and Production. See docs/deploy.md.
# Never commit real values. Every value below is a placeholder.

# Public base URL of the site, no trailing slash (canonical links, sitemap, absolute URLs).
# Local: http://localhost:3000. Production: the Vercel production domain. Preview: leave unset
# or point at the preview domain. NEXT_PUBLIC_* values are inlined at build time and visible
# to browsers, so never put a secret in one.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres connection used by the running app (Prisma client, added by SFT-6).
# Hosted: use the provider's POOLED connection string (Neon "-pooler" host, or Supabase
# transaction pooler on port 6543), because serverless functions open many short connections.
# Neon/Supabase require TLS: keep sslmode=require.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Direct (non-pooled) connection used only by Prisma migrations (`prisma migrate deploy`).
# Migrations need a session-level connection, so this must NOT be the pooled URL.
# Locally it can equal DATABASE_URL.
# DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Secret for signing auth sessions/cookies (added when accounts land). Generate one per
# environment with `openssl rand -base64 32`; Preview and Production must differ.
# AUTH_SECRET=replace-with-a-long-random-string
