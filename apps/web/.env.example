# apps/web environment variables — copy to .env.local and fill in real values locally.
# Never commit real values. SFT-7 needs no variables to build or run; these are placeholders
# for the issues that will use them.

# Public base URL of the site (used later for canonical links / sitemap). Placeholder only.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database connection (added by SFT-6, Prisma). Placeholder only.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
