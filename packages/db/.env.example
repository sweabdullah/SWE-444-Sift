# Copy to packages/db/.env (git-ignored) and fill in.
# PostgreSQL connection string used by the Prisma CLI (migrate, studio) and the Prisma client.
# The team's local Docker container (sift-pg) listens on host port 54329 ; use the credentials the team agreed for it.
# Replace <your_db> with your own database name; change the port if your Postgres runs elsewhere.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:54329/<your_db>?schema=public"
