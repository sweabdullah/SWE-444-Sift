{
  "name": "sift",
  "private": true,
  "description": "Sift — a bilingual (AR/EN) catalogue of Saudi credit cards where every figure traces back to the bank that published it.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm build && pnpm -r --if-present run typecheck",
    "lint": "eslint . && pnpm --filter web lint:logical",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm build",
    "db:generate": "pnpm --filter @sift/db db:generate",
    "db:migrate": "pnpm --filter @sift/db db:migrate",
    "db:deploy": "pnpm --filter @sift/db db:deploy",
    "db:seed": "pnpm --filter @sift/db db:seed",
    "db:studio": "pnpm --filter @sift/db db:studio",
    "test": "pnpm -r --if-present run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.2",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
